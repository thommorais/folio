{
	// ========================================
	// PACKAGE MANAGER
	// ========================================
	"npm.packageManager": "pnpm",
	// ========================================
	// EDITOR CONFIGURATION
	// ========================================
	"editor.formatOnSave": true,
	"editor.formatOnPaste": true,
	"editor.codeActionsOnSave": {
		"source.fixAll.oxc": "explicit",
		"source.organizeImports.oxc": "always",
		"source.addMissingImports.oxc": "explicit",
		"source.organizeImports": "always"
	},
	"editor.defaultFormatter": "oxc.oxc-vscode",
	"oxc.fmt.configPath": ".oxfmtrc.json",
	"editor.bracketPairColorization.enabled": true,
	"editor.guides.bracketPairs": "active",
	"editor.inlayHints.enabled": "on",
	// ========================================
	// TYPESCRIPT/JAVASCRIPT CONFIGURATION
	// ========================================
	"js/ts.suggest.autoImports": true,
	"js/ts.suggest.includeAutomaticOptionalChainCompletions": true,
	"js/ts.updateImportsOnFileMove.enabled": "always",
	"js/ts.preferences.includePackageJsonAutoImports": "off",
	"js/ts.tsdk.promptToUseWorkspaceVersion": true,
	"js/ts.preferences.importModuleSpecifier": "non-relative",
	"js/ts.tsdk.path": "./node_modules/typescript/lib",
	// ========================================
	// LANGUAGE FORMATTERS
	// ========================================
	"[markdown]": {
		"editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
	},
	"[javascript]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[javascriptreact]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[typescript]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[json]": {
		"editor.defaultFormatter": "vscode.json-language-features"
	},
	"[jsonc]": {
		"editor.defaultFormatter": "vscode.json-language-features"
	},
	// ========================================
	// CSS
	// ========================================
	"css.lint.unknownAtRules": "ignore",
	// ========================================
	// SPELL CHECKER
	// ========================================
	"cSpell.words": [
		"VITE",
		"wayfinder"
	],
	// ========================================
	// FILE EXPLORER
	// ========================================
	"explorer.sortOrder": "filesFirst",
	"explorer.fileNesting.enabled": true,
	"explorer.fileNesting.patterns": {
		"package.json": "pnpm-lock.yaml, .nvmrc, .node-version, .oxlintrc.json, .oxfmtrc.json, .npmrc, cog.toml, nx.json, pnpm-workspace.yaml, CLAUDE*.md, .gitignore, README.md",
		"tsconfig.json": "tsconfig*.json",
		"*.ts": "${capture}.test.ts, ${capture}.spec.ts, ${capture}.int.spec.ts",
		"*.tsx": "${capture}.test.tsx, ${capture}.spec.tsx, ${capture}.module.css, ${capture}.stories.tsx",
		".env": ".env*, .envrc, .env.example",
		"Dockerfile": "docker-compose*.yml, .dockerignore",
		"README.md": "CHANGELOG.md, CONTRIBUTING.md, LICENSE, CODE_OF_CONDUCT.md, CLAUDE.md, AGENTS.md",
		"next.config.js": "next-env.d.ts, next-sitemap.config.cjs",
		"payload.config.ts": "payload-types.ts",
		"vitest.config.mts": "vitest.setup.ts"
	},
	"explorer.confirmDelete": false,
	"explorer.confirmDragAndDrop": false,
	// ========================================
	// FILES & SEARCH CONFIGURATION
	// ========================================
	"files.watcherExclude": {
		"**/node_modules/**": true,
		"**/.next/**": true,
		"**/tmp/**": true,
		"**/coverage/**": true,
		"**/dist/**": true,
		"**/.cache/**": true
	},
	"search.exclude": {
		"**/node_modules": true,
		"**/.next": true,
		"**/coverage": true,
		"**/tmp": true,
		"**/dist": true,
		"**/.cache": true,
		"pnpm-lock.yaml": true,
		"package-lock.json": true,
		"**/*.tsbuildinfo": true,
		"**/payload-types.ts": true
	},
	"files.associations": {
		".env*": "dotenv",
		"*.graphql": "graphql"
	},
	"files.exclude": {
		"**/.DS_Store": true,
		"**/.next": false
	},
	"files.trimTrailingWhitespace": true,
	"files.insertFinalNewline": true,
	"files.trimFinalNewlines": true,
	// ========================================
	// GIT INTEGRATION
	// ========================================
	"git.ignoreLimitWarning": true,
	"git.untrackedChanges": "separate",
	"git.enableSmartCommit": false,
	"git.confirmSync": false,
	"git.autofetch": true,
	"tailwindCSS.classFunctions": [
		"tw",
		"clsx",
		"tw\\.[a-z-]+",
		"cn",
		"tv",
		"tv\\.[a-z-]+"
	],
	"editor.quickSuggestions": {
		"strings": "on"
	}
}
